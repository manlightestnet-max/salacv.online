# Copie en .env (jamais commité). Seuls les secrets de DÉMARRAGE sont ici : tout le reste
# (clés des fournisseurs IA, attribution, Firebase…) se règle dans l'interface admin (/admin/ → Clés IA).

# Base Neon (Postgres). Sans elle : base locale PGlite (data/pg), développement seulement.
DATABASE_URL=

# Chiffre les clés d'API enregistrées en base (32 octets, base64). À SAUVEGARDER.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SALACV_MASTER_KEY=

SALACV_SESSION_SECRET=
# UID Firebase du compte Google de l'admin (Firebase Console → Authentication → Utilisateurs → UID).
# Plusieurs UID : séparés par des virgules. L'admin se connecte uniquement avec Google.
SALACV_ADMIN_UID=

# Développement local uniquement : autorise l'ancienne connexion par mot de passe (fermée sinon).
# SALACV_ALLOW_PASSWORD_LOGIN=1

# App desktop (Electron) : page de connexion et backend.
# SALACV_AUTH_ORIGIN=https://smlab-theta.vercel.app
