{
  "name": "salacv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "salacv — éditeur de CV pour étudiants (DSL -> Skia / PDF)",
  "scripts": {
    "render": "node bin/render.js",
    "dev": "vite",
    "build": "vite build",
    "test": "node --test test/*.test.js",
    "start": "node server/index.js",
    "i18n": "node scripts/i18n.js",
    "electron": "npm run build && electron .",
    "electron:dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "aws4fetch": "^1.0.20",
    "canvaskit-wasm": "^0.42.0",
    "docx": "^9.8.1",
    "firebase": "^12.19.0",
    "jose": "^6.2.12",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.salacv.app",
    "productName": "salacv",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "server/**",
      "src/**",
      "api/**",
      "dist/**",
      "fonts/**",
      "resources/**",
      "examples/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
